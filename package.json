{
  "name": "@local/dsh-model-router-web",
  "version": "0.1.0",
  "type": "module",
  "description": "Per-turn and per-subagent model and reasoning-effort routing for the DeepSeek Harness, driven by a configurable decision model.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shinchen6/dsh-decision-model.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "model-router",
    "decision-model",
    "llm"
  ]
}
